# ---- Postgres (docker compose creates the db; this password is used for both) ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Used when the API runs on the host (bun run dev / bun test). Inside compose it is built for you.
DATABASE_URL=postgres://yspace:change-me-to-a-long-random-string@localhost:5432/yspace

PORT=3000
API_PORT=3000

# URL of your frontend (used to build the shareable space link)
PUBLIC_WEB_URL=http://localhost:5173
# Comma separated origins, or * for any. Defaults to * (all origins)
# CORS_ORIGINS=*

# true when running behind nginx/caddy so client IPs come from X-Forwarded-For
TRUST_PROXY=false

MAX_SPEAKERS=5
MAX_PARTICIPANTS=100
ADMIN_SESSION_TTL_HOURS=72
RECONNECT_GRACE_SECONDS=15

# Forgotten-space safety net (0 turns a rule off). A space is ended automatically when:
MAX_SPACE_HOURS=8           # it has been live this long, no matter what
HOST_ABSENT_MINUTES=15      # the host is not connected (never entered, closed the tab, lost network)
EMPTY_ROOM_MINUTES=30       # the host is connected but nobody else has been there
AUTO_END_WARN_MINUTES=5     # warn this long before an automatic end; the host can press "keep it going"
EXTEND_MINUTES=60           # how much time "keep it going" adds

# Raise-hand queue: "auto" uses pgmq (Postgres) when installed, "memory" keeps the line in memory.
SPEAK_QUEUE=auto

# Scheduler. With the pg_cron image (see db/Dockerfile) Postgres wakes the API every N seconds; without it the API uses its own timer.
SCHEDULER_TICK_SECONDS=10
AUTO_START_GRACE_MINUTES=30 # a scheduled space this far past its time is left for the host to start by hand

# ---- WebRTC (mediasoup). One port, open for BOTH UDP and TCP in your firewall. ----
RTC_LISTEN_IP=0.0.0.0
# Your server's PUBLIC IP (required in production; LAN IP / 127.0.0.1 for local testing)
RTC_ANNOUNCED_IP=127.0.0.1
RTC_PORT=44444
